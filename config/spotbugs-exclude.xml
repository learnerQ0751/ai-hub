<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 启动类无业务逻辑，跳过检查 -->
    <Match>
        <Class name="com.qtua.aihub.AiHubApplication"/>
    </Match>
    <!-- 配置绑定 Bean 需要暴露可变 Map/List 供 Spring Binder 使用 -->
    <Match>
        <Class name="com.qtua.aihub.config.GatewayProperties"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.config.GatewayProperties$Deployment"/>
    </Match>
    <!-- Spring 构造器注入的对象由容器管理生命周期，不属于真实暴露 -->
    <Match>
        <Class name="com.qtua.aihub.filter.AuthFilter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.gateway.ChatCompletionService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
