<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 启动类无业务逻辑，跳过检查 -->
    <Match>
        <Class name="com.qtua.aihub.AiHubApplication"/>
    </Match>
    <!-- 配置绑定 Bean 需要暴露可变 Map/List 供 Spring Binder 使用 -->
    <Match>
        <Class name="com.qtua.aihub.common.config.GatewayProperties"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.common.config.GatewayProperties$Deployment"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.common.config.PricingProperties"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.common.config.PricingProperties$Price"/>
    </Match>
    <!-- Spring 构造器注入的对象由容器管理生命周期，不属于真实暴露 -->
    <Match>
        <Class name="com.qtua.aihub.start.filter.AuthFilter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.integration.protocol.OpenAiProtocolAdapter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.service.ChatCompletionServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.service.ModelServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.core.ChatCompletionCore"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.core.routing.WeightedRandomSelector"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.manager.ApiKeyManager"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.manager.CallLogManager"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.manager.pricing.YamlPricingCatalog"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.integration.ratelimit.RedisRateLimiter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.service.gateway.DefaultGatewayGuard"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.service.gateway.GatewayChatCompletionService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.service.gateway.GatewayGovernanceService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.start.filter.GatewayGovernanceFilter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.service.KeyServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.qtua.aihub.start.config.MasterKeyStartupValidator"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- metadata 允许 null 值，构造器中已用 unmodifiableMap 包装 -->
    <Match>
        <Class name="com.qtua.aihub.manager.model.ApiKeyBO"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!-- 响应 DTO：List 已在紧凑构造器中 List.copyOf 防御性拷贝 -->
    <Match>
        <Class name="com.qtua.aihub.api.model.res.ModelListResDTO"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
