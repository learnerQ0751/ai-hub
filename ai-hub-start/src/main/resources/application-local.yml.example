gateway:
  master-key: sk-local-master-key
  model-list:
    chat:
      - api-base: https://api.deepseek.com
        api-key: ${DEEPSEEK_API_KEY:}
        model: deepseek-chat
        rpm: 600
      - api-base: https://api.deepseek.com
        api-key: ${DEEPSEEK_API_KEY_2:}
        model: deepseek-chat
        rpm: 200
    reasoner:
      - api-base: https://api.deepseek.com
        api-key: ${DEEPSEEK_API_KEY:}
        model: deepseek-reasoner
  # 价格表：按上游真实模型配置每 1M tokens 单价（按供应商实际价格调整）
  pricing:
    models:
      deepseek-chat:
        input-per-million: 0.27
        output-per-million: 1.10
      deepseek-reasoner:
        input-per-million: 0.55
        output-per-million: 2.19

# 控制台管理员会话：密码哈希用 scripts/hash-console-password.ps1 生成后填入。
console:
  session:
    enabled: ${CONSOLE_SESSION_ENABLED:false}
    username: ${CONSOLE_ADMIN_USERNAME:}
    password-hash: ${CONSOLE_ADMIN_PASSWORD_HASH:}
    # 本地 http 演示设为 false；HTTPS 部署保持 true
    cookie-secure: ${CONSOLE_SESSION_COOKIE_SECURE:true}
    timeout: 2h
    max-failed-attempts: 5
    lock-duration: 30s
