<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qtua.aihub.dal.mapper.AdminSessionMapper">

    <resultMap id="AdminSessionResultMap" type="com.qtua.aihub.dal.model.AdminSessionDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="token_hash" property="tokenHash" jdbcType="VARCHAR"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="expires_at" property="expiresAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.qtua.aihub.dal.model.AdminSessionDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_sessions (token_hash, username, created_at, expires_at)
        VALUES (#{tokenHash,jdbcType=VARCHAR}, #{username,jdbcType=VARCHAR},
                #{createdAt,jdbcType=TIMESTAMP}, #{expiresAt,jdbcType=TIMESTAMP})
    </insert>

    <select id="selectByTokenHash" resultMap="AdminSessionResultMap">
        SELECT id, token_hash, username, created_at, expires_at
        FROM admin_sessions
        WHERE token_hash = #{tokenHash,jdbcType=VARCHAR}
    </select>

    <delete id="deleteByTokenHash">
        DELETE FROM admin_sessions WHERE token_hash = #{tokenHash,jdbcType=VARCHAR}
    </delete>

    <delete id="deleteExpired">
        DELETE FROM admin_sessions WHERE expires_at &lt;= #{now,jdbcType=TIMESTAMP}
    </delete>
</mapper>
